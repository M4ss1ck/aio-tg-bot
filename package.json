{
    "name": "aio-tg-bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx --env-file=.env telegram/runner/polling.ts",
        "dev:next": "pnpm set-webhook && next dev",
        "build": "pnpm prisma && next build --webpack",
        "build-only": "next build --webpack",
        "start": "next start",
        "test": "node --import tsx --test",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "set-webhook": "tsx --env-file=.env scripts/set-webhook.ts",
        "studio": "prisma studio",
        "prisma-generate": "prisma generate",
        "prisma-push": "prisma db push",
        "prisma": "pnpm prisma-generate && pnpm prisma-push"
    },
    "dependencies": {
        "@fontsource-variable/kode-mono": "^5.1.0",
        "@fontsource/federant": "^5.1.0",
        "@grammyjs/auto-retry": "^2.0.2",
        "@grammyjs/hydrate": "^1.4.1",
        "@grammyjs/parse-mode": "^1.9.0",
        "@grammyjs/storage-redis": "^2.4.0",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.0.0",
        "@resvg/resvg-js": "^2.6.2",
        "axios": "^1.1.3",
        "cheerio": "^1.0.0-rc.10",
        "expr-eval": "^2.0.2",
        "fast-csv": "^4.3.6",
        "grammy": "^1.21.1",
        "i18next": "^22.5.0",
        "i18next-fs-backend": "^2.1.2",
        "ioredis": "^5.3.2",
        "jimp": "^0.16.2",
        "jsqr": "^1.4.0",
        "next": "16.0.8",
        "qrcode": "^1.5.1",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-turnstile": "^1.0.6",
        "request-ip": "^3.3.0",
        "satori": "^0.26.0",
        "sharp": "^0.32.1",
        "signale": "^1.4.0",
        "twig": "^1.15.4",
        "urban-dictionary-client": "^3.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.0",
        "@types/node": "^22",
        "@types/qrcode": "^1.5.0",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@types/request-ip": "^0.0.37",
        "@types/signale": "^1.4.4",
        "@types/telegram-web-app": "^7.10.0",
        "eslint": "^9",
        "eslint-config-next": "16.0.5",
        "postcss": "^8",
        "prisma": "^7.0.0",
        "tailwindcss": "^4.1.0",
        "tsx": "^4.7.0",
        "typescript": "^5.6.2"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "19.2.7",
            "@types/react-dom": "19.2.3"
        }
    },
    "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
