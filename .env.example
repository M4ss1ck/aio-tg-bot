# Required
TOKEN=                        # Main bot token from @BotFather
DATABASE_URL=                 # PostgreSQL connection string (e.g. postgres://user:pass@host:5432/tgbot)
ADMIN_ID=                     # Telegram user ID of the bot admin
NEXT_PUBLIC_DOMAIN=           # Public domain with protocol (e.g. https://bot.example.com)
NEXT_PUBLIC_SITEKEY=          # Site key for the Telegram Web App

# Redis (omit to use in-memory sessions — data lost on restart)
REDIS_URL=                    # Redis URL (e.g. redis://localhost:6379)

# AI features (omit to disable)
OPENROUTER_API_KEY=           # OpenRouter API key for free AI models
CLOUDFLARE_API_TOKEN=         # Cloudflare Workers AI token for premium models
CLOUDFLARE_ACCOUNT_ID=        # Cloudflare account ID

# Optional
TG_API=                       # Custom Telegram API server (default: https://api.telegram.org)
TGWD_SECRET=                  # Telegram Web App validation secret
VICTIM_ID=                    # Easter egg target user ID

# Local dev (used by `docker compose --profile dev up`)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tgbot
# REDIS_URL=redis://localhost:6379
