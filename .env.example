# Required
TOKEN=                        # Main bot token from @BotFather
DATABASE_URL=                 # PostgreSQL connection string (e.g. postgres://user:pass@host:5432/tgbot)
ADMIN_ID=                     # Telegram user ID of the bot admin
NEXT_PUBLIC_DOMAIN=           # Public domain with protocol (e.g. https://bot.example.com)
NEXT_PUBLIC_SITEKEY=          # Site key for the Telegram Web App

# Portfolio (read-only upstream for project data)
# Server-only. Do NOT rename to NEXT_PUBLIC_*; browser code never needs it.
PORTFOLIO_API_URL=https://www.massick.dev

# Production startup
# Automatically register the Telegram webhook once the web server is listening.
SET_WEBHOOK_ON_START=true
# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header so the /api/bot route can reject forged requests. Leave empty to
# disable verification. Allowed characters: A-Z a-z 0-9 _ - (1-256 chars).
TG_WEBHOOK_SECRET=

# Redis
# Inside Docker Compose (default): redis://redis:6379
# Local host access to compose Redis: redis://localhost:6380
REDIS_URL=

# AI features (omit to disable)
OPENROUTER_API_KEY=           # OpenRouter API key for free AI models
CLOUDFLARE_API_TOKEN=         # Cloudflare Workers AI token for premium models
CLOUDFLARE_ACCOUNT_ID=        # Cloudflare account ID

# Optional
TG_API=                       # Custom Telegram API server (default: https://api.telegram.org)
TGWD_SECRET=                  # Telegram Web App validation secret
VICTIM_ID=                    # Easter egg target user ID
LOG_LEVEL=                    # Logger verbosity (default: info; set to "debug" for per-message/webhook traces)

# Local Docker Compose port overrides
# APP_PORT=3000
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=tgbot
# DATABASE_URL=postgres://postgres:postgres@db:5432/tgbot
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/tgbot
